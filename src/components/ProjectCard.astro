---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const {
  title,
  tagline,
  summary,
  category,
  tags,
  status,
  startDate,
  highlights,
  cover,
  coverAlt,
  links,
} = project.data;

const year = startDate.getFullYear();

const statusLabels: Record<string, { text: string; class: string }> = {
  'completed': { text: 'completed', class: 'text-accent border-accent/40 bg-accent/5' },
  'in-progress': { text: 'in-progress', class: 'text-amber-400 border-amber-400/40 bg-amber-400/5' },
  'archived': { text: 'archived', class: 'text-muted border-border bg-surface' },
};

const currentStatus = statusLabels[status] || statusLabels['in-progress'];
---

<article
  class:list={[
    'matrix-card group flex flex-col justify-between overflow-hidden p-5 transition-all duration-200',
    featured ? 'sm:p-6' : '',
  ]}
  data-category={category}
  data-tags={tags.join(',')}
>
  <div>
    <!-- Cover Thumbnail -->
    <a href={`/projects/${project.id}`} class="block overflow-hidden rounded-[1px] border border-border mb-4 aspect-video relative bg-bg">
      <Image
        src={cover}
        alt={coverAlt}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02] opacity-90 group-hover:opacity-100"
        loading={featured ? 'eager' : 'lazy'}
      />
      <!-- Status Badge (Top Right) -->
      <span class:list={['absolute top-2.5 right-2.5 font-mono text-[11px] px-2 py-0.5 border rounded-[2px] backdrop-blur-sm', currentStatus.class]}>
        {currentStatus.text}
      </span>
    </a>

    <!-- Header & Category -->
    <div class="flex items-center justify-between text-xs font-mono text-muted mb-2">
      <span class="tracking-wide uppercase text-[10px] text-muted">~/{category}</span>
      <span>{year}</span>
    </div>

    <!-- Title & Tagline -->
    <h3 class="text-xl font-semibold text-heading group-hover:text-accent transition-colors mb-2">
      <a href={`/projects/${project.id}`} class="hover:underline underline-offset-2">
        {title}
      </a>
    </h3>

    <p class="text-sm text-text/90 line-clamp-2 mb-4 font-serif">
      {tagline || summary}
    </p>

    <!-- Highlights (if available on featured cards) -->
    {highlights && highlights.length > 0 && (
      <ul class="mb-4 space-y-1 font-mono text-xs text-muted border-l border-border pl-3">
        {highlights.slice(0, 2).map((h) => (
          <li class="line-clamp-1 text-text/80">&bull; {h}</li>
        ))}
      </ul>
    )}
  </div>

  <!-- Bottom: Tech Tags and Quick Action Links -->
  <div class="pt-4 border-t border-border/60 mt-auto flex flex-col gap-3">
    <!-- Tech Tags (DS-6) -->
    <div class="flex flex-wrap gap-1.5 font-mono text-xs">
      {tags.map((tag) => (
        <a
          href={`/projects?tag=${encodeURIComponent(tag.toLowerCase())}`}
          class="tech-tag"
          title={`Filter by ${tag}`}
        >
          [{tag.toLowerCase()}]
        </a>
      ))}
    </div>

    <!-- Action Links -->
    <div class="flex items-center justify-between pt-1 font-mono text-xs">
      <a
        href={`/projects/${project.id}`}
        class="text-accent hover:underline underline-offset-2 flex items-center gap-1 font-medium"
      >
        <span>Case study</span>
        <span>&rarr;</span>
      </a>

      <div class="flex items-center gap-3 text-muted">
        {links.repo && (
          <a
            href={links.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent hover:underline underline-offset-2 transition-colors"
          >
            repo
          </a>
        )}
        {links.demo && (
          <a
            href={links.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent hover:underline underline-offset-2 transition-colors"
          >
            demo
          </a>
        )}
        {links.writeup && (
          <a
            href={links.writeup}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent hover:underline underline-offset-2 transition-colors"
          >
            writeup
          </a>
        )}
      </div>
    </div>
  </div>
</article>
