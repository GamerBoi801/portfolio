---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortProjects } from '../../lib/projects';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects', ({ data }) => !data.draft);
  const sorted = sortProjects(allProjects);

  return sorted.map((project, index) => {
    const prevProject = index > 0 ? sorted[index - 1] : null;
    const nextProject = index < sorted.length - 1 ? sorted[index + 1] : null;

    return {
      params: { slug: project.id },
      props: { project, prevProject, nextProject },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await render(project);

const {
  title,
  tagline,
  summary,
  category,
  tags,
  status,
  startDate,
  endDate,
  role,
  teamSize,
  highlights,
  cover,
  coverAlt,
  video,
  links,
} = project.data;

const dateRange = `${formatDate(startDate)} — ${endDate ? formatDate(endDate) : 'Present'}`;

const statusLabels: Record<string, { text: string; class: string }> = {
  'completed': { text: 'completed', class: 'text-accent border-accent/40 bg-accent/5' },
  'in-progress': { text: 'in-progress', class: 'text-amber-400 border-amber-400/40 bg-amber-400/5' },
  'archived': { text: 'archived', class: 'text-muted border-border bg-surface' },
};

const currentStatus = statusLabels[status] || statusLabels['in-progress'];
---

<BaseLayout
  title={`${title} — Case Study`}
  description={summary}
  maxWidth="prose"
>
  <article class="py-12 sm:py-16">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-mono text-muted mb-6">
      <a href="/projects" class="text-accent hover:underline underline-offset-2">~/projects</a>
      <span>/</span>
      <span>{project.id}</span>
    </div>

    <!-- HEADER (Case Study Header) -->
    <header class="mb-10 pb-8 border-b border-border">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono text-xs uppercase tracking-wider text-muted">~/{category}</span>
        <span class:list={['font-mono text-xs px-2 py-0.5 border rounded-[2px]', currentStatus.class]}>
          {currentStatus.text}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-heading glow-text mb-4">
        {title}
      </h1>

      <p class="text-lg text-text/90 font-serif leading-relaxed mb-6">
        {tagline}
      </p>

      <!-- Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 matrix-card font-mono text-xs mb-6">
        <div>
          <span class="text-muted block mb-1">Timeline</span>
          <span class="text-text">{dateRange}</span>
        </div>
        <div>
          <span class="text-muted block mb-1">Role</span>
          <span class="text-text">{role}</span>
        </div>
        <div>
          <span class="text-muted block mb-1">Team Size</span>
          <span class="text-text">{teamSize} {teamSize === 1 ? 'person' : 'people'}</span>
        </div>
        <div>
          <span class="text-muted block mb-1">Status</span>
          <span class="text-text capitalize">{status}</span>
        </div>
      </div>

      <!-- Tech Tags -->
      <div class="flex flex-wrap gap-2 font-mono text-xs mb-6">
        {tags.map((tag) => (
          <a
            href={`/projects?tag=${encodeURIComponent(tag.toLowerCase())}`}
            class="tech-tag"
          >
            [{tag.toLowerCase()}]
          </a>
        ))}
      </div>

      <!-- Action Links / Buttons -->
      <div class="flex flex-wrap items-center gap-4 font-mono text-xs">
        {links.repo && (
          <a
            href={links.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent text-bg font-semibold px-3.5 py-2 rounded-[2px] hover:bg-accent-dim transition-colors flex items-center gap-1.5"
          >
            <span>GitHub Repository</span>
            <span>&rarr;</span>
          </a>
        )}
        {links.demo && (
          <a
            href={links.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-accent text-accent px-3.5 py-2 rounded-[2px] hover:bg-accent/10 transition-colors flex items-center gap-1.5"
          >
            <span>Live Demo</span>
            <span>&rarr;</span>
          </a>
        )}
        {links.writeup && (
          <a
            href={links.writeup}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-border text-text hover:text-accent hover:border-accent px-3.5 py-2 rounded-[2px] transition-colors"
          >
            Sanitized Summary &rarr;
          </a>
        )}
        {video && (
          <a
            href={video}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-border text-text hover:text-accent hover:border-accent px-3.5 py-2 rounded-[2px] transition-colors"
          >
            Video Demo &rarr;
          </a>
        )}
      </div>
    </header>

    <!-- HERO VISUAL -->
    <div class="mb-12 overflow-hidden rounded-[2px] border border-border bg-surface">
      <Image
        src={cover}
        alt={coverAlt}
        class="w-full h-auto object-cover"
        loading="eager"
      />
      <div class="p-3 border-t border-border font-mono text-xs text-muted">
        <span>Figure 1: {coverAlt}</span>
      </div>
    </div>

    <!-- MEASURED HIGHLIGHTS (If present) -->
    {highlights && highlights.length > 0 && (
      <div class="mb-12 p-5 matrix-card border-l-2 border-l-accent">
        <span class="font-mono text-xs text-accent uppercase tracking-wider block mb-2">Key Engineering Metrics</span>
        <ul class="space-y-1.5 font-mono text-xs text-text">
          {highlights.map((h) => (
            <li class="flex items-start gap-2">
              <span class="text-accent">&bull;</span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- MDX CASE STUDY CONTENT (Problem, Approach, Results, Challenges, What's Next) -->
    <div class="prose prose-invert max-w-none">
      <Content />
    </div>

    <!-- PREV / NEXT NAVIGATION (FR-13) -->
    <nav class="mt-16 pt-8 border-t border-border flex items-center justify-between font-mono text-xs">
      <div>
        {prevProject && (
          <a
            href={`/projects/${prevProject.id}`}
            class="text-muted hover:text-accent hover:underline flex items-center gap-1 group"
          >
            <span>&larr;</span>
            <span>prev: {prevProject.data.title}</span>
          </a>
        )}
      </div>

      <div>
        <a href="/projects" class="text-accent hover:underline">
          [all projects]
        </a>
      </div>

      <div>
        {nextProject && (
          <a
            href={`/projects/${nextProject.id}`}
            class="text-muted hover:text-accent hover:underline flex items-center gap-1 group"
          >
            <span>next: {nextProject.data.title}</span>
            <span>&rarr;</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>
