---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Not Found"
  description="The requested page could not be found."
  maxWidth="prose"
>
  <div class="py-24 sm:py-32 text-center">
    <span class="section-label">~/error/404</span>

    <h1 class="text-6xl sm:text-7xl font-mono font-bold text-accent glow-text mb-6">
      404
    </h1>

    <h2 class="text-2xl sm:text-3xl font-semibold text-heading mb-4 font-serif">
      Signal Lost: Node Not Found
    </h2>

    <p class="text-text font-serif text-lg leading-relaxed mb-8 max-w-md mx-auto">
      The requested URI does not exist or has been relocated to another address in the system.
    </p>

    <div class="inline-block p-4 matrix-card font-mono text-xs text-left text-muted mb-8 max-w-sm w-full">
      <div>&gt; status: 404_NOT_FOUND</div>
      <div>&gt; target: document.location.pathname</div>
      <div>&gt; recovery: return_to_origin()</div>
    </div>

    <div class="flex items-center justify-center gap-4 font-mono text-sm">
      <a
        href="/"
        class="bg-accent text-bg font-semibold px-4 py-2.5 rounded-[2px] hover:bg-accent-dim transition-colors"
      >
        Return to Home &rarr;
      </a>
      <a
        href="/projects"
        class="border border-border text-text hover:text-accent hover:border-accent px-4 py-2.5 rounded-[2px] transition-colors"
      >
        View Projects
      </a>
    </div>
  </div>
</BaseLayout>
